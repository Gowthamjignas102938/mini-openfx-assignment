{
  "name": "miniopenfx",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "node --env-file-if-exists=.env node_modules/.bin/nest start",
    "start:dev": "node --env-file-if-exists=.env node_modules/.bin/nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node --env-file-if-exists=.env dist/main",
    "lint": "oxlint src/ test/",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "npm run build && node --env-file-if-exists=.env dist/db/seed.js",
    "test": "node --experimental-vm-modules --env-file-if-exists=.env node_modules/.bin/jest",
    "test:watch": "node --experimental-vm-modules --env-file-if-exists=.env node_modules/.bin/jest --watch",
    "test:cov": "node --experimental-vm-modules --env-file-if-exists=.env node_modules/.bin/jest --coverage",
    "test:debug": "node --experimental-vm-modules --env-file-if-exists=.env --inspect-brk node_modules/.bin/jest --runInBand",
    "test:e2e": "node --experimental-vm-modules --env-file-if-exists=.env node_modules/.bin/jest --config ./test/jest-e2e.json --forceExit"
  },
  "dependencies": {
    "@nestjs/axios": "^12.0.1",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "axios": "^1.20.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^6.0.0",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "drizzle-kit": "^0.31.10",
    "jest": "^30.5.1",
    "oxlint": "^1.58.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.2"
  }
}
