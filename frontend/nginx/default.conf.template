# nginx config for the frontend container. It is a template: at startup the
# nginx image replaces ${API_KEY} with the value of the API_KEY env var,
# which Kubernetes fills in from the openfx-secrets Secret.
server {
    # Port nginx listens on inside the container (non-root, so not port 80)
    listen 8080;

    # Where the built React files live
    root /usr/share/nginx/html;

    # Health check for Kubernetes probes
    location = /healthz {
        return 200 'ok';
    }

    # API calls: forward /v1/... to the API Service inside the cluster and
    # attach the API key here, so the browser never sees or needs it
    location /v1/ {
        proxy_pass http://openfx-api:80;
        proxy_set_header X-API-Key "${API_KEY}";
        proxy_set_header Host $host;
    }

    # Everything else: serve the file if it exists, otherwise the React app
    location / {
        try_files $uri /index.html;
    }
}
